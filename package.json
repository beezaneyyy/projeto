{
  "name": "nutrisnap",
  "version": "0.1.0",
  "private": true,
  "description": "NutriSnap - acompanhamento de alimentacao, calorias e treino com analise de refeicoes por IA",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "core:build": "npm run build --workspace @nutrisnap/core",
    "core:dev": "npm run dev --workspace @nutrisnap/core",
    "core:test": "npm run test --workspace @nutrisnap/core"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}

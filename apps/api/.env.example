# =============================================================================
# NutriSnap API - variaveis de ambiente
#
# Copie para `.env` e preencha. NUNCA comite o `.env`.
# Nenhuma destas variaveis pode aparecer no app React Native - todas ficam
# exclusivamente no servidor.
# =============================================================================

NODE_ENV=development
PORT=3333
LOG_LEVEL=debug

# --- Banco de dados ----------------------------------------------------------
# DATABASE_URL: conexao usada pela aplicacao. No Supabase, use o pooler (porta
# 6543) com pgbouncer=true - serverless abre muitas conexoes curtas.
DATABASE_URL="postgresql://postgres:senha@localhost:5432/nutrisnap?schema=public"
# DIRECT_DATABASE_URL: conexao direta (porta 5432), usada apenas por
# `prisma migrate`. O pooler nao suporta os comandos de DDL da migration.
DIRECT_DATABASE_URL="postgresql://postgres:senha@localhost:5432/nutrisnap?schema=public"

# --- Supabase (Auth + Storage) -----------------------------------------------
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
# Chave publica (publishable). Usada apenas para operacoes em nome do usuario.
SUPABASE_ANON_KEY="eyJ..."
# SEGREDO. Ignora RLS. Usada so para gerar signed URLs das fotos e tarefas
# administrativas. Se vazar, o banco inteiro vaza.
SUPABASE_SERVICE_ROLE_KEY="eyJ..."
# Segredo de assinatura do JWT, para validar tokens offline sem round-trip.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters"
# Bucket privado das fotos de refeicao.
SUPABASE_MEAL_PHOTOS_BUCKET="meal-photos"

# --- IA ----------------------------------------------------------------------
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY="sk-ant-..."
# Modelo de visao/planos. Trocavel sem alterar codigo.
AI_MODEL="claude-opus-5"
# Timeout por chamada. Acima disso o app recebe erro e oferece entrada manual.
AI_TIMEOUT_MS=45000
# Tentativas quando o output nao passa na validacao Zod.
AI_MAX_VALIDATION_RETRIES=1

# --- Limites de uso ----------------------------------------------------------
# Analises de foto por usuario por dia. Protege a conta do provedor de abuso.
RATE_LIMIT_ANALYSIS_PER_DAY=30
RATE_LIMIT_PLAN_GENERATION_PER_DAY=5
RATE_LIMIT_GLOBAL_PER_MINUTE=120

# --- Observabilidade ---------------------------------------------------------
SENTRY_DSN=""
